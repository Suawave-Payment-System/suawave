{
    "name": "suawave/module-payment",
    "description": "Accept stablecoin payments such as USDT in Magento 2. An order is paid only after a signed callback verifies.",
    "version": "1.0.0",
    "type": "magento2-module",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-bcmath": "*",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-openssl": "*",
        "magento/framework": "^103.0",
        "magento/module-sales": "^103.0",
        "magento/module-payment": "^100.4",
        "magento/module-checkout": "^100.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Suawave\\Payment\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Suawave\\Payment\\Test\\Unit\\": "Test/Unit/"
        }
    },
    "scripts": {
        "test": "phpunit -c phpunit.xml.dist"
    }
}
