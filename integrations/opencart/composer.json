{
  "name": "suawave/opencart",
  "description": "Accept stablecoin payments such as USDT in OpenCart. An order is paid only after a signed callback verifies.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.1",
    "ext-bcmath": "*",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "Suawave\\": "upload/extension/suawave/system/library/suawave/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Suawave\\Tests\\": "tests/"
    }
  },
  "config": {
    "platform-check": false
  },
  "scripts": {
    "test": "phpunit"
  }
}
