{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-payment" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
      <div class="card-body">
        <form id="form-payment" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_callback_url }}</label>
            <div class="col-sm-10"><input type="text" value="{{ callback_url }}" class="form-control" readonly/></div>
          </div>
          <div class="row mb-3">
            <label for="input-base-url" class="col-sm-2 col-form-label">{{ entry_base_url }}</label>
            <div class="col-sm-10">
              <input type="text" name="payment_suawave_base_url" value="{{ payment_suawave_base_url }}" id="input-base-url" class="form-control"/>
              <div class="form-text">{{ help_base_url }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-ticker" class="col-sm-2 col-form-label">{{ entry_ticker }}</label>
            <div class="col-sm-10">
              <input type="text" name="payment_suawave_ticker" value="{{ payment_suawave_ticker }}" id="input-ticker" class="form-control"/>
              <div class="form-text">{{ help_ticker }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-payout" class="col-sm-2 col-form-label">{{ entry_payout_address }}</label>
            <div class="col-sm-10">
              <input type="text" name="payment_suawave_payout_address" value="{{ payment_suawave_payout_address }}" id="input-payout" class="form-control"/>
              <div class="form-text">{{ help_payout_address }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-public-key" class="col-sm-2 col-form-label">{{ entry_public_key }}</label>
            <div class="col-sm-10">
              <textarea name="payment_suawave_public_key" rows="6" id="input-public-key" class="form-control">{{ payment_suawave_public_key }}</textarea>
              <div class="form-text">{{ help_public_key }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-origin" class="col-sm-2 col-form-label">{{ entry_external_origin }}</label>
            <div class="col-sm-10">
              <input type="text" name="payment_suawave_external_origin" value="{{ payment_suawave_external_origin }}" id="input-origin" class="form-control"/>
              <div class="form-text">{{ help_external_origin }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-currency" class="col-sm-2 col-form-label">{{ entry_order_currency }}</label>
            <div class="col-sm-10">
              <input type="text" name="payment_suawave_order_currency" value="{{ payment_suawave_order_currency }}" id="input-currency" class="form-control"/>
              <div class="form-text">{{ help_order_currency }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-pending-status" class="col-sm-2 col-form-label">{{ entry_pending_status }}</label>
            <div class="col-sm-10">
              <select name="payment_suawave_pending_status_id" id="input-pending-status" class="form-select">
                {% for order_status in order_statuses %}
                  <option value="{{ order_status.order_status_id }}"{% if order_status.order_status_id == payment_suawave_pending_status_id %} selected{% endif %}>{{ order_status.name }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-paid-status" class="col-sm-2 col-form-label">{{ entry_paid_status }}</label>
            <div class="col-sm-10">
              <select name="payment_suawave_paid_status_id" id="input-paid-status" class="form-select">
                {% for order_status in order_statuses %}
                  <option value="{{ order_status.order_status_id }}"{% if order_status.order_status_id == payment_suawave_paid_status_id %} selected{% endif %}>{{ order_status.name }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-sort-order" class="col-sm-2 col-form-label">{{ entry_sort_order }}</label>
            <div class="col-sm-10"><input type="text" name="payment_suawave_sort_order" value="{{ payment_suawave_sort_order }}" id="input-sort-order" class="form-control"/></div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_status }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="payment_suawave_status" value="0"/>
                <input type="checkbox" name="payment_suawave_status" value="1" id="input-status" class="form-check-input"{% if payment_suawave_status %} checked{% endif %}/>
              </div>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
